# GitHub Personal Access Token (optional, kintu recommended - na dile rate limit kom pabe)
# Token banate: https://github.com/settings/tokens -> Generate new token (classic) -> no scope select korle o cholbe (public repo read only)
GITHUB_TOKEN=your_github_personal_access_token_here

# Search query - kon type er repo extract korte chao
# Example: stars:>1000  (1000+ star wala repo)
SEARCH_QUERY=stars:>1000

# Optional - specific language e filter korte chaile (e.g. Python, JavaScript). Empty rakhle shob language ashbe
LANGUAGE_FILTER=

# Koyta repository fetch korte chao
FETCH_LIMIT=100

# PostgreSQL Database Config
DB_HOST=localhost
DB_PORT=5432
DB_NAME=github_etl
DB_USER=postgres
DB_PASSWORD=your_password_here
